{
  "name": "backend",
  "version": "1.0.0",
  "description": "Call center API – Express, Drizzle, PostgreSQL",
  "main": "dist/src/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/src/server/index.js",
    "db:generate": "node -r tsx/cjs -r dotenv/config ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node -r dotenv/config ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node -r tsx/cjs -r dotenv/config ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node -r dotenv/config ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
