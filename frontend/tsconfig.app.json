{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"],
      "@api": ["./src/api"],
      "@api/*": ["./src/api/*"],
      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"],
      "@router": ["./src/router"],
      "@router/*": ["./src/router/*"],
      "@modules": ["./src/modules"],
      "@modules/*": ["./src/modules/*"]
    },
    "module": "ESNext"
  }
}
