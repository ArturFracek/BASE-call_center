{
  "files": [],
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.app.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@api": ["./src/api"],
      "@api/*": ["./src/api/*"],
      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"],
      "@router": ["./src/router"],
      "@router/*": ["./src/router/*"],
      "@modules": ["./src/modules"],
      "@modules/*": ["./src/modules/*"]
    },
    "module": "ESNext"
  }
}
